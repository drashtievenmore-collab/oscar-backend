# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (db.md 1.1 - PostgreSQL 15+)
DB_NAME=evenmore_erp
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes (api.md 1.2)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# CORS (api-integration.md blocker 6) - the Vite dev origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Files (api.md 1.12). Backend "local" serves presigned-style URLs from this server.
FILE_STORAGE_BACKEND=local
FILE_MAX_BYTES=26214400
PMS_PROOF_MAX_BYTES=52428800

# Exchange rates (api.md 12.4) - fetched server-side, cached a day
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD

# Module toggle: HRMS-only dev mode (no code edits needed)
# True  -> only auth/admin/hrms (+ core platform) routes are mounted
# False -> full ERP routes are mounted
HRMS_ONLY=True
# Optional exact override (comma-separated route keys):
# masters,inventory,sales,purchase,accounting,crm,pms,hrms,reports,dashboard,public
# Example HRMS + careers portal only:
# ENABLED_MODULES=hrms,public
# Example full ERP:
# ENABLED_MODULES=masters,inventory,sales,purchase,accounting,crm,pms,hrms,reports,dashboard,public
